  "source": "2024년 고1 3월 전국연합학력평가 20번",
  "stemRuns": [
   {
    "t": "그림과 같이 한 변의 길이가 12인 정삼각형 ABC의 변 BC 위에 "
   },
   {
    "eq": "overline {DC}",
    "w": 1620,
    "h": 1240,
    "bl": 89
   },
   {
    "eq": "= 4",
    "w": 1540,
    "h": 990,
    "bl": 86
   },
